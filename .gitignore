/target
.serena/

# Byte-compiled / optimized / DLL files
__pycache__/
.pytest_cache/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
.venv/
env/
bin/
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
include/
man/
venv/
# The Python-packaging patterns above (bin/, build/, include/, lib/, etc.) are
# bare directory names, so they match anywhere in the tree — not just at a
# venv root. That silently swept up real vendored C source under
# vendor/espeak-ng/ (its own include/ dirs for public headers) during git add,
# so CI's fresh clone was missing them even though local working trees had
# them on disk. Un-ignore this vendored tree explicitly; extend this rule to
# any future vendor/ directory that hits the same collision.
!crates/text/espeak-phonemizer/vendor/espeak-ng/**
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt
pip-selfcheck.json

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.cache
nosetests.xml
coverage.xml

